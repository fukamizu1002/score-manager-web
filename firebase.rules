rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function profile(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function sameCampus(campusId){
      return signedIn() && profile().data.campusId == campusId;
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /campuses/{campusId}/{document=**} {
      allow read, write: if sameCampus(campusId);
    }
  }
}

